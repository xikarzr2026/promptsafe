{
  "manifest_version": 3,
  "name": "PromptSafe — Secret Scrubber",
  "version": "2.1.0",
  "description": "Locally scrub selected text before sharing it with an AI assistant.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "action": {
    "default_title": "PromptSafe — Scrub Secrets"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
