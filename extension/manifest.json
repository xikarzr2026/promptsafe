{
  "manifest_version": 3,
  "name": "PromptSafe — Secret Scrubber",
  "version": "2.2.0",
  "description": "Locally scrub selected text before sharing it with an AI assistant.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "PromptSafe — Scrub Secrets",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "scrub-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Scrub the selected text in the focused field"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
